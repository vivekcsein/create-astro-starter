{
  "name": "create-astro-template",
  "version": "1.0.0",
  "description": "An opinionated Astro template for building modern, enterprise-grade web apps.",
  "type": "module",
  "private": true,
  "scripts": {
    "themes:build": "bun run src/packages/scripts/build-themes.ts",
    "predev": "bun run themes:build",
    "prebuild": "bun run themes:build",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --fix .",
    "typecheck": "astro check",
    "verify": "bun run lint && bun run format && bun run check && bun run typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@fontsource/inika": "^5.3.0",
    "astro": "^7.4.2",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "author": "@frenzzofficial",
  "license": "CC0-1.0",
  "keywords": [
    "astro",
    "template",
    "typescript",
    "tailwindcss",
    "bun",
    "biome"
  ]
}
