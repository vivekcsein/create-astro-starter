---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/packages/utils/cn";
import type { ButtonSize, ButtonVariant } from "@/types/app";

type Props = HTMLAttributes<"button"> & {
  variant?: ButtonVariant;
  size?: ButtonSize;
  type?: "button" | "submit" | "reset";
};

const {
  variant = "primary",
  size = "md",
  type = "button",
  class: className,
  ...rest
} = Astro.props;

const sizes: Record<ButtonSize, string> = {
  sm: "h-9 px-4 text-sm",
  md: "h-11 px-5 text-[0.9375rem]",
  lg: "h-12 px-7 text-base",
  icon: "size-11 px-0",
};

const base =
  "group relative isolate inline-flex items-center justify-center overflow-hidden whitespace-nowrap rounded-lg font-medium leading-none select-none cursor-pointer transition-[transform,box-shadow,border-color,filter,background-color] duration-300 ease-out active:translate-y-0 active:scale-[0.97] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 disabled:transform-none disabled:shadow-none";

const variants: Record<ButtonVariant, string> = {
  primary:
    "bg-linear-to-br from-primary via-primary to-primary/75 text-primary-foreground border border-primary/20 hover:-translate-y-0.5 hover:border-transparent hover:brightness-[1.03] hover:shadow-[0_8px_24px_-12px_var(--primary)] active:shadow-[0_4px_12px_-8px_var(--primary)]",
  secondary:
    "bg-background/40 text-foreground border-2 border-border hover:-translate-y-0.5 hover:border-primary hover:bg-background/50 hover:shadow-[0_8px_24px_-12px_var(--primary)] active:shadow-[0_4px_12px_-8px_var(--primary)]",
};

const shineVia = variant === "primary" ? "via-white/35" : "via-white/20";
---
<button type={type} class={cn(base, variants[variant], sizes[size], className)} {...rest}>
  <span
    aria-hidden="true"
    class={cn(
      "pointer-events-none absolute inset-y-0 left-[-75%] z-0 w-1/2 skew-x-[-20deg] bg-linear-to-r from-transparent to-transparent opacity-0 transition-[left,opacity] duration-900 ease-out group-hover:left-[125%] group-hover:opacity-100",
      shineVia,
    )}
  />
  <span class="relative z-10 inline-flex items-center gap-2">
    <slot />
  </span>
</button>
