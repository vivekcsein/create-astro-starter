---
import { cn } from "@/packages/utils/cn";
import type { CardVariant } from "@/types/app";

type Props = {
  variant?: CardVariant;
  class?: string;
};

const { variant = "primary", class: className } = Astro.props;
const interactive = variant === "interactive";
---
<article
  class={cn(
    "group relative isolate overflow-hidden rounded-lg border border-border/70 bg-card text-card-foreground shadow-xs",
    interactive &&
      "transition-[border-color,box-shadow,transform] duration-300 ease-out hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-lg",
    className,
  )}
>
  {interactive && (
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-20 -top-20 size-40 rounded-full bg-primary/8 blur-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100"
    />
  )}
  {interactive && (
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-primary/60 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    />
  )}
  <div class="relative z-10 p-5">
    <slot />
  </div>
</article>
