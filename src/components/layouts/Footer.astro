---
import { appConfig } from "@/packages/configs/app.config";
import { footerNav } from "@/packages/configs/navigation.config";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-top">
      <div class="site-footer-brand">
        <Logo size={96} />
        <p class="site-footer-tagline">{appConfig.site.description}</p>
      </div>

      <nav class="site-footer-nav" aria-label="Footer">
        <div class="site-footer-columns">
          {
            footerNav.map((section) => (
              <div class="site-footer-column">
                <h4 class="site-footer-heading">{section.title}</h4>
                <ul class="site-footer-links">
                  {section.items.map((item) => (
                    <li>
                      <a href={item.href} class="site-footer-link">
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <div class="site-footer-accordion">
          {
            footerNav.map((section) => (
              <div class="accordion-item" data-accordion-item>
                <button type="button" class="accordion-trigger" aria-expanded="false" data-accordion-trigger>
                  <span class="accordion-title">{section.title}</span>
                  <span class="accordion-chevron" aria-hidden="true" />
                </button>
                <section class="accordion-panel">
                  <div class="accordion-panel-inner">
                    <div class="accordion-panel-content">
                      <ul class="site-footer-links">
                        {section.items.map((item) => (
                          <li>
                            <a href={item.href} class="site-footer-link">
                              {item.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </section>
              </div>
            ))
          }
        </div>
      </nav>
    </div>

    <div class="site-footer-bottom">
      <p class="site-footer-copyright">
        &copy; {year} {appConfig.app.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<script>
  for (const trigger of document.querySelectorAll<HTMLElement>(".site-footer-accordion [data-accordion-trigger]")) {
    trigger.addEventListener("click", () => {
      const item = trigger.closest<HTMLElement>("[data-accordion-item]");
      const willOpen = item?.getAttribute("data-open") !== "true";
      item?.setAttribute("data-open", String(willOpen));
      trigger.setAttribute("aria-expanded", String(willOpen));
    });
  }
</script>
