# Committed, no real values — the Zod schemas in src/packages/env are the
# source of truth; this file documents them for onboarding.
# Copy to .env and fill in real values.
#
# Astro only exposes variables prefixed PUBLIC_ to the browser.

PUBLIC_APP_NAME=create-astro-template
PUBLIC_APP_VERSION=1.0.0
PUBLIC_APP_DESCRIPTION=Future-ready frontend template for building robust, enterprise-level web apps.
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SITE_TITLE=Astro frontend template
PUBLIC_LOGO_URL=/logo.png
PUBLIC_ACTIVE_STYLE=cyantrix-theme

PUBLIC_AUTHOR_NAME=frenzzofficial
PUBLIC_AUTHOR_EMAIL=
PUBLIC_TWITTER=https://x.com/frenzzofficial
PUBLIC_LINKEDIN=https://www.linkedin.com/company/frenzz
PUBLIC_GITHUB=https://github.com/frenzzofficial

# Future backend (not wired yet)
PUBLIC_API_ORIGIN=http://localhost:7164
PUBLIC_API_PREFIX=app
